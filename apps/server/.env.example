# Copy to .env.local and fill in. Never commit real values.

# Local Postgres (see README: Homebrew cluster on 5433 or podman).
DATABASE_URL=postgres://bouncer:<password>@localhost:5433/bouncer

# Static bearer token for local dev only: read-only (GET alerts/audit) and ignored in production.
# Write actions always need a per-device token from pairing (/pair).
DEVICE_TOKEN=

# Operator secret typed into /pair and /audit (and Bearer for /api/admin/*). openssl rand -hex 32
ADMIN_SECRET=

# Telegram webhook: the `secret_token` passed to setWebhook (1-256 chars, A-Z a-z 0-9 _ -).
# Telegram sends it back in X-Telegram-Bot-Api-Secret-Token. openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated chat ids the bot moderates (e.g. -1001234567890). Updates from other chats are ignored,
# and moderation actions are only allowed here.
TELEGRAM_ALLOWED_CHATS=
# Comma-separated keywords that auto-flag a message (case-insensitive substring match).
FLAG_KEYWORDS=
# Bot token (BotFather) for getChatMember / deleteMessage / restrictChatMember / banChatMember.
# The bot must be a group admin with "delete messages" and "ban users" rights. Never logged (scrubbed).
TELEGRAM_BOT_TOKEN=

# Write actions. ACTIONS_DRY_RUN=1 skips the Telegram Bot API calls (fake provider).
ACTIONS_DRY_RUN=
# Dry run only: comma-separated user ids treated as group admins (stand-in for getChatMember).
DRY_RUN_ADMIN_IDS=
# Optional: nonce TTL override (seconds, 1–300, default 60) and pair starts per IP per 10 min (default 5).
ACTION_NONCE_TTL_SECONDS=
PAIR_RATE_LIMIT=

# Voice commands (POST /api/voice): Cartesia batch STT (ink-whisper, en). Unset → 503.
CARTESIA_API_KEY=
# AI risk label (POST /api/alerts/{id}/summary, only when the Detail screen opens): Anthropic
# claude-haiku-5-5, label spam|scam|toxic|ok|unclear. Unset → heuristic fallback (label "unclear").
# The flagged text (≤ 500 chars) goes to Anthropic only on that request. AI_LABELS=0 turns AI off.
ANTHROPIC_API_KEY=
AI_LABELS=
# Dev/selftest only (ignored in production): VOICE_STT_MOCK=1 reads the transcript from the
# `x-mock-transcript` header; SUMMARY_AI_MOCK=1 fakes the AI when `x-mock-ai: 1` is sent.
VOICE_STT_MOCK=
SUMMARY_AI_MOCK=

# Daily retention purge (GET /api/cron/purge, scheduled in vercel.json): Vercel Cron sends
# `Authorization: Bearer <CRON_SECRET>`. Alerts older than 7 days are deleted. openssl rand -hex 24
CRON_SECRET=

# Comma-separated origins allowed to call /api/alerts from the glasses WebView.
GLASSES_ORIGINS=http://localhost:5173

# Used by scripts/demo-seed.
SERVER_URL=http://localhost:3300
